{
  "Jwt": {
    "Issuer": "contacts-record-api",
    "Audience": "contacts-record-web",
    "ExpirationMinutes": 60
  },
  "Imports": {
    "BatchSize": 500
  },
  "RabbitMq": {
    "QueueName": "contact-imports"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
